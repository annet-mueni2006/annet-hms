# Copy to .env and fill in. NEVER commit .env.
APP_NAME="Annet Healthcare"
# URL folder where the app lives, no trailing slash. Leave this line commented out to detect it automatically.
# Set it only if the links go to the wrong place: /annet-hms for http://localhost/annet-hms, or APP_BASE= (empty) at a domain root.
# APP_BASE=/annet-hms

DB_HOST=127.0.0.1
DB_NAME=annet_hms
DB_USER=root
DB_PASS=

# Gmail SMTP with an App Password (Google Account > Security > 2-Step Verification > App passwords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your.address@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM=your.address@gmail.com
MAIL_FROM_NAME="Annet Healthcare"

OTP_TTL_MINUTES=10